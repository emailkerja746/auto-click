<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="24dp">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Pengaturan AutoClick"
        android:textSize="20sp"
        android:textStyle="bold"
        android:layout_marginBottom="16dp" />

    <Button
        android:id="@+id/btnEnableAccessibility"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="1. Aktifkan Accessibility Service" />

    <Button
        android:id="@+id/btnEnableOverlay"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="2. Izinkan Tampil di Atas App Lain" />

    <EditText
        android:id="@+id/etClickX"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:hint="Koordinat X klik (misal 500)"
        android:inputType="number" />

    <EditText
        android:id="@+id/etClickY"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="Koordinat Y klik (misal 800)"
        android:inputType="number" />

    <Button
        android:id="@+id/btnPickPoint"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="📍 Pilih Titik Langsung di Layar" />

    <EditText
        android:id="@+id/etInterval"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="Interval klik (ms), misal 1000"
        android:inputType="number" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:text="Kata kunci jeda (pisah pakai koma jika lebih dari satu). Auto-click akan JEDA otomatis saat kata ini muncul di layar, dan LANJUT lagi kalau sudah hilang. Contoh: PERINGATAN akan jeda di popup peringatan apapun."
        android:textSize="12sp" />

    <EditText
        android:id="@+id/etKeyword"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="PERINGATAN"
        android:hint="misal: PERINGATAN, Warning, Notice" />

    <Button
        android:id="@+id/btnStart"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:text="3. Mulai Auto-Click" />

</LinearLayout>
